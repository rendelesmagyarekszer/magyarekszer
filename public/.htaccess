# Biztonsági védelem: az orders.json fájl közvetlen letöltésének tiltása
<Files "orders.json">
  Order allow,deny
  Deny from all
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API végpontok átirányítása a megfelelő PHP szkriptekre
  RewriteRule ^api/send-order-email/?$ api/send-order-email.php [L]
  RewriteRule ^api/orders/?$ api/orders.php [L]
  RewriteRule ^api/check-kh-emails/?$ api/check-kh-emails.php [L]
  RewriteRule ^api/admin/save-products/?$ api/save-products.php [L]
  RewriteRule ^api/admin/settings/?$ api/settings.php [L]
  RewriteRule ^api/upload/?$ api/upload.php [L]

  # 1. Ha a kért fájl vagy mappa létezik, közvetlenül azt szolgáljuk ki
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Ha mappa index.html létezik
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 3. Ha .html végződéssel létezik fájl (pl. /about -> /about.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. Egyéb esetben fallback a gyökér index.html-re (kliensoldali Next.js router)
  RewriteRule ^ index.html [L]
</IfModule>
